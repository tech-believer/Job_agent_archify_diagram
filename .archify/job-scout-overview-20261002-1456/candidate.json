    {
      "dot": "cyan",
      "title": "1. Upload your CV",
      "items": [
        "What: drop a PDF resume in the web app.",
        "Why: this is the only starting input."
      ]
    },
    {
      "dot": "emerald",
      "title": "2. Build a profile",
      "items": [
        "What: read the PDF and list skills, roles, and experience.",
        "Why: later steps compare jobs to this snapshot, not the raw file."
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Search openings",
      "items": [
        "What: look up real job ads that match those roles.",
        "Why: ranking only works on actual openings."
      ]
    },
    {
      "dot": "emerald",
      "title": "4. Score each job",
      "items": [
        "What: give every opening a 0–100 fit score.",
        "Why: you see the best matches first, not a random dump."
      ]
    },
    {
      "dot": "amber",
      "title": "5. Retry if matches are thin",
      "items": [
        "What: if fewer than 5 jobs score 60 or higher, rewrite the search and look again.",
        "Why: a slightly broader query often finds more real fits. This happens at most twice."
      ]
    },
    {
      "dot": "cyan",
      "title": "6. See ranked jobs",
      "items": [
        "What: a sorted list with why each job matches and what is missing.",
        "Why: you can judge the role honestly before you apply."
      ]
    }
  ]
